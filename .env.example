# Optional local database settings.
# The demo already defaults to XAMPP MariaDB on 127.0.0.1:3306
# with database=smart_stay, user=root and an empty password.
# These variables are read from the operating-system environment.

SMART_STAY_DB_NAME=smart_stay
SMART_STAY_DB_USER=root
SMART_STAY_DB_PASSWORD=
SMART_STAY_DB_HOST=127.0.0.1
SMART_STAY_DB_PORT=3306

# Optional Django settings for non-local deployments.
SMART_STAY_SECRET_KEY=change-this-for-a-real-deployment
SMART_STAY_DEBUG=True
SMART_STAY_ALLOWED_HOSTS=127.0.0.1,localhost
